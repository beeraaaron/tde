<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="mainStructure" prefHeight="1024.0" prefWidth="1600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <MenuBar id="appMenu" prefHeight="25.0" BorderPane.alignment="CENTER">
            <Menu fx:id="fileMenu" mnemonicParsing="false">
                <MenuItem fx:id="languageMenu" mnemonicParsing="false" onAction="#onSwitchLanguage" />
                <MenuItem fx:id="buildingMenu" mnemonicParsing="false" onAction="#onLoadBuildings" />
                <MenuItem fx:id="boundaryMenu" mnemonicParsing="false" onAction="#onLoadBoundaries" />
                <SeparatorMenuItem mnemonicParsing="false" />
                <MenuItem fx:id="exitMenu" mnemonicParsing="false" onAction="#onAppExit" />
            </Menu>
            <Menu fx:id="helpMenu" mnemonicParsing="false">
                <MenuItem fx:id="aboutMenu" mnemonicParsing="false" />
            </Menu>
        </MenuBar>
    </top>
    <bottom>
        <VBox BorderPane.alignment="CENTER">
            <HBox>
                <Label fx:id="commandLabel" prefHeight="25.0" text="Command:" />
                <Region prefHeight="25.0" prefWidth="5.0" />
                <TextField prefHeight="25.0" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox>
                <Label fx:id="statusLabel" prefHeight="30.0" />
                <Label fx:id="status" prefHeight="30.0" />
            </HBox>
        </VBox>
    </bottom>
   <center>
      <StackPane fx:id="center" BorderPane.alignment="CENTER" />
   </center>
   <right>
       <VBox prefWidth="200.0" BorderPane.alignment="CENTER">
           <BorderPane.margin>
               <Insets />
           </BorderPane.margin>
           <padding>
               <Insets left="5.0" />
           </padding>
           <VBox>
               <Label fx:id="scaleLabel">
                   <font>
                       <Font name="System Bold" size="12.0" />
                   </font>
               </Label>
               <Label fx:id="scale" text="Label" />
           </VBox>
           <HBox>
               <VBox prefWidth="100.0">
                   <Label fx:id="mouseLabel">
                       <font>
                           <Font name="System Bold" size="12.0" />
                       </font>
                   </Label>
                   <HBox VBox.vgrow="NEVER">
                       <Label text="x:" />
                       <Label fx:id="mouseX" text="Label" HBox.hgrow="ALWAYS" />
                   </HBox>
                   <HBox VBox.vgrow="NEVER">
                       <Label text="y:" />
                       <Label fx:id="mouseY" text="Label" HBox.hgrow="ALWAYS" />
                   </HBox>
               </VBox>
               <VBox layoutX="10.0" layoutY="10.0" prefWidth="100.0">
                   <Label fx:id="coordinateLabel">
                       <font>
                           <Font name="System Bold" size="12.0" />
                       </font>
                   </Label>
                   <HBox VBox.vgrow="NEVER">
                       <Label text="e:" />
                       <Label fx:id="coordE" text="Label" HBox.hgrow="ALWAYS" />
                   </HBox>
                   <HBox VBox.vgrow="NEVER">
                       <Label text="n:" />
                       <Label fx:id="coordN" text="Label" HBox.hgrow="ALWAYS" />
                   </HBox>
               </VBox>
           </HBox>
           <Separator />
           <VBox prefWidth="200.0" prefHeight="150" BorderPane.alignment="CENTER">
               <Label fx:id="layerLabel">
                   <font>
                       <Font name="System Bold" size="12.0" />
                   </font>
               </Label>
               <VBox fx:id="layers">
               </VBox>
           </VBox>
       </VBox>
   </right>
</BorderPane>
